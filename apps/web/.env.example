# Optional native web configuration. Copy to .env.local for next dev.
# For the standalone launcher, set these in the process environment instead.
# The root .env is read by FastAPI, not by Next.js.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# This is server-only configuration. Never use NEXT_PUBLIC_* for secrets.

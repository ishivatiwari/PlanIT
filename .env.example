# Phase 3 configuration reference. Keep secrets empty here.
# For native Windows setup, scripts/local_postgres.py init generates ignored .env.
# For Compose, scripts/compose_env.py generates a separate ignored .env.compose.
APP_ENV=development
APP_URL=http://localhost:3000
# Exact browser origin used by authentication. Production requires HTTPS.
# Development/test also permits localhost/127.0.0.1 aliases on the same port.
# Native web default; Compose supplies http://api:8000 to the web container.
# Set this in the web process environment; Next.js does not load this root file.
API_INTERNAL_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# Backend only. Use different least-privilege runtime and migration credentials.
# Proposed format: postgresql+psycopg://USER:PASSWORD@HOST:5432/eventora
# Native helper uses 127.0.0.1:55432. Compose injects its own db:5432 URLs.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Optional integration-test database; its name must end in _test.
TEST_DATABASE_URL=

# Compose credentials: generated URL-safe values; never reuse in production.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=

# Phase 2 uses local accounts and database-backed sessions. No identity-provider
# credentials or shared demo password are required. Register through the UI.

# Enable only after setting a Gemini key and an accessible structured-output model.
# Do not place keys in NEXT_PUBLIC_* variables. No guessed model identifier.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# One total deadline, including at most one retry. No tool calls.
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=6000
# Per account, rolling 24-hour limit. Intake and generation each count once.
AI_DAILY_REQUESTS=20
